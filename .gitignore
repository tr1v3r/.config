# Whitelist via "/*": ignore only top-level entries, then re-include dirs/files.
# "/*" (unlike "*") does not match nested paths, so once a dir is re-included its
# contents are automatically trackable — no "!**/" re-include-dirs line is needed.
# Bonus: any top-level dir NOT re-included below (e.g. dependency caches coc/,
# yarn/) is pruned at the root, so git never descends into them and never reads
# their nested .gitignore files (which would un-ignore vendored package contents).
/*

# repo metadata (root files — no trailing slash)
!/.gitignore
!/.gitmodules
!/.gitattributes
!/README.md
!/CLAUDE.md

# git-crypt: encrypted key material (safe to commit, GPG-wrapped)
!/.git-crypt/

# --- submodules (see .gitmodules; ranger plugins are nested under !/ranger/) ---
!/firefox/
!/nvim/
!/zsh/

# --- service stacks: runtime state in per-dir .gitignore; *.env git-crypt encrypted ---
!/adguard-home/
!/bt/
!/emby/
!/karakeep/
!/pihole/

# --- other tracked dirs (alphabetical) ---
!/aerc/
!/ai/
!/bashtop/
!/cargo/
!/conda/
!/deploy/
!/gpg/
!/iterm2/
!/kitty/
!/lazygit/
!/neofetch/
!/ranger/
!/scripts/
!/secrets/
!/snipaste/
!/ssh/
!/tmux/
!/tmux-powerline/
!/yazi/

# raycast: only diy_plugins/ and scripts/ tracked (narrowing lives in raycast/.gitignore)
!/raycast/

# root-level tracked files
!/picom.conf
!/starship.toml

# --- global ignores (filter junk inside the tracked dirs above) ---
*.log
*.pyc
*.pyo
.codegraph/
.mypy_cache/
__pycache__/
