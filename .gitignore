# ignore all files and folders
*

# do not ignore .gitignore
!.gitignore
!.gitmodules
!.gitattributes
!README.md

# git-crypt: encrypted key material (safe to commit, GPG-wrapped)
!.git-crypt/**

# do not ignore all directories
!**/

# do not ignore specified directories
!bashtop/**
!cargo/**
!conda/**
!gpg/**
!kitty/**
!lazygit/**
!neofetch/**
!ranger/**
!raycast/diy_plugins/**
!raycast/scripts/**
!scripts/**
!snipaste/**
!ssh/**
!starship.toml
!tmux-powerline/**
!tmux/**
!yazi/**
yazi/flavors/

# git submodules directories
!iterm2/**
# !karabiner/**
!nvim/**
!zsh/**
!deploy/**

# adguard-home: conf/ is git-crypt encrypted and tracked; work/ is runtime state
!adguard-home/**
adguard-home/work/
!ai/
!ai/**
!aerc/**
!secrets
!secrets/**

# do not ignore picom.conf
!picom.conf

# python
*.pyc
*.pyo
.mypy_cache/
__pycache__

# ranger
# ranger/plugins/__init__.py

# codegraph
.codegraph/

# log
*.log

# lazygit
lazygit/state.yml

yarn/
coc/
