# skhd bindings for the yabai profile.
# Colemak navigation: n/e/u/i = left/down/up/right.
# skhd is stopped when AeroSpace is selected, avoiding duplicate hotkeys.

# Focus windows.
alt - n : yabai -m window --focus west
alt - e : yabai -m window --focus south
alt - u : yabai -m window --focus north
alt - i : yabai -m window --focus east

# Reorder tiled windows; at an edge, send to the adjacent display.
alt + shift - n : yabai -m window --swap west  || yabai -m window --display west
alt + shift - e : yabai -m window --swap south || yabai -m window --display south
alt + shift - u : yabai -m window --swap north || yabai -m window --display north
alt + shift - i : yabai -m window --swap east  || yabai -m window --display east

# Layout and lifecycle.
alt - slash       : yabai -m space --layout bsp
alt - comma       : yabai -m space --layout stack
alt - f           : yabai -m window --toggle zoom-fullscreen
alt + shift - space : yabai -m window --toggle float
alt - b           : yabai -m space --balance
alt - r           : yabai -m space --rotate 90
alt + shift - q   : yabai -m window --close
alt - tab         : yabai -m space --focus recent
alt + shift - tab : yabai -m window --display next --focus

# Workspaces.
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt + shift - 1 : yabai -m window --space 1 --focus
alt + shift - 2 : yabai -m window --space 2 --focus
alt + shift - 3 : yabai -m window --space 3 --focus
alt + shift - 4 : yabai -m window --space 4 --focus
alt + shift - 5 : yabai -m window --space 5 --focus
alt + shift - 6 : yabai -m window --space 6 --focus
alt + shift - 7 : yabai -m window --space 7 --focus
alt + shift - 8 : yabai -m window --space 8 --focus
alt + shift - 9 : yabai -m window --space 9 --focus

# Resize by 50 px. Each fallback handles the opposite edge of a BSP split.
ctrl + alt - n : yabai -m window --resize left:-50:0  || yabai -m window --resize right:-50:0
ctrl + alt - e : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
ctrl + alt - u : yabai -m window --resize top:0:-50   || yabai -m window --resize bottom:0:-50
ctrl + alt - i : yabai -m window --resize right:50:0  || yabai -m window --resize left:50:0
