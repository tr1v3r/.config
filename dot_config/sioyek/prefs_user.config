# Sioyek user preferences — Catppuccin Mocha, technical-reading defaults.
# Sioyek 2.0.0 loads this through a symlink installed into its macOS app bundle.

use_legacy_keybinds 0
check_for_updates_on_startup 0
should_load_tutorial_when_no_other_file 0
should_launch_new_window 0

# Reading/navigation behavior.
move_screen_ratio 0.72
zoom_inc_factor 1.15
wheel_zoom_on_cursor 1
fit_to_page_width_ratio 0.86
touchpad_sensitivity 0.75
sort_bookmarks_by_location 1
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000
collapsed_toc 0
multiline_menus 1
rerender_overview 1
prerendered_page_count 3
case_sensitive_search 0
show_document_name_in_statusbar 1
show_closest_bookmark_in_statusbar 1
show_close_portal_in_statusbar 1

# Keep the application chrome dark without forcing every PDF/figure to invert.
background_color 0.118 0.118 0.180
dark_mode_background_color 0.118 0.118 0.180
dark_mode_contrast 0.85
ui_background_color 0.118 0.118 0.180
ui_text_color 0.804 0.839 0.957
ui_selected_background_color 0.271 0.278 0.353
ui_selected_text_color 0.796 0.651 0.969
status_bar_color 0.118 0.118 0.180
status_bar_text_color 0.651 0.678 0.784
status_bar_font_size 13
ui_font Hack Nerd Font Mono
font_size 15

# F8 toggles this paper-friendly custom color mode; it is not forced at startup.
custom_background_color 0.118 0.118 0.180
custom_text_color 0.804 0.839 0.957

# Search and annotation colors.
text_highlight_color 0.976 0.886 0.686
search_highlight_color 0.651 0.890 0.631
link_highlight_color 0.537 0.706 0.980
synctex_highlight_color 0.796 0.651 0.969
visual_mark_color 0.537 0.706 0.980 0.18
search_url_s https://scholar.google.com/scholar?q=
search_url_g https://www.google.com/search?q=
middle_click_search_engine s
shift_middle_click_search_engine g
