# Sioyek user bindings. Defaults remain available; these add a Colemak layer.
# n/e/u/i = left/down/up/right, matching Neovim and Herdr.

move_left n
move_down e
move_up u
move_right i
move_left <left>
move_down <down>
move_up <up>
move_right <right>

screen_down <C-e>
screen_up <C-u>
prev_state [
next_state ]

# Paper-friendly Catppuccin custom colors and portal helper window.
toggle_custom_color <f8>
toggle_window_configuration <f12>

# Keep common Vim muscle memory explicit.
goto_beginning gg
goto_end G
search /
next_item gn
previous_item gN
command :
quit q
