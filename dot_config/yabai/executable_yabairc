#!/bin/sh
# yabai BSP profile. Core tiling works with SIP enabled; this template avoids
# scripting-addition-only features. Select it with ~/.config/wm/use yabai.

# Reserve SketchyBar's top strip only when it is installed.
external_bar='off:0:0'
if command -v sketchybar >/dev/null 2>&1; then
  external_bar='all:32:0'
fi

yabai -m config \
  external_bar "$external_bar" \
  menubar_opacity 1.0 \
  mouse_follows_focus off \
  focus_follows_mouse off \
  display_arrangement_order default \
  window_origin_display default \
  window_placement second_child \
  window_insertion_point focused \
  window_zoom_persist on \
  window_shadow on \
  skip_window_focus_animation off \
  window_animation_duration 0.0 \
  window_opacity_duration 0.0 \
  active_window_opacity 1.0 \
  normal_window_opacity 1.0 \
  window_opacity off \
  insert_feedback_color 0xffcba6f7 \
  split_ratio 0.50 \
  split_type auto \
  auto_balance off \
  top_padding 8 \
  bottom_padding 8 \
  left_padding 8 \
  right_padding 8 \
  window_gap 8 \
  layout bsp \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap

# Native utility windows do not tile well.
yabai -m rule --add app='^System Settings$' manage=off
yabai -m rule --add app='^Calculator$' manage=off
yabai -m rule --add app='^Activity Monitor$' manage=off

# Feed workspace lifecycle events into the shared SketchyBar config.
if command -v sketchybar >/dev/null 2>&1; then
  for label in \
    sketchybar_space_changed \
    sketchybar_space_created \
    sketchybar_space_destroyed \
    sketchybar_display_added \
    sketchybar_display_removed
  do
    yabai -m signal --remove "$label" >/dev/null 2>&1 || true
  done

  yabai -m signal --add label=sketchybar_space_changed \
    event=space_changed action='sketchybar --trigger yabai_space_change'
  yabai -m signal --add label=sketchybar_space_created \
    event=space_created action='sketchybar --reload'
  yabai -m signal --add label=sketchybar_space_destroyed \
    event=space_destroyed action='sketchybar --reload'
  yabai -m signal --add label=sketchybar_display_added \
    event=display_added action='sketchybar --reload'
  yabai -m signal --add label=sketchybar_display_removed \
    event=display_removed action='sketchybar --reload'

  sketchybar --reload >/dev/null 2>&1 || true
fi

echo 'yabai configuration loaded'
