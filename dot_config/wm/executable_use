#!/bin/sh
# Switch between the mutually exclusive AeroSpace and yabai profiles.
set -eu

usage() {
  echo 'usage: ~/.config/wm/use aerospace|yabai|off|status' >&2
  exit 2
}

have() { command -v "$1" >/dev/null 2>&1; }

stop_aerospace() {
  if pgrep -x AeroSpace >/dev/null 2>&1; then
    osascript -e 'tell application "AeroSpace" to quit' >/dev/null 2>&1 || pkill -x AeroSpace || true
  fi
}

stop_yabai() {
  have skhd && skhd --stop-service >/dev/null 2>&1 || true
  have yabai && yabai --stop-service >/dev/null 2>&1 || true
}

reload_bar() {
  have sketchybar || return 0
  if pgrep -x sketchybar >/dev/null 2>&1; then
    sketchybar --reload >/dev/null 2>&1 || true
  elif have brew; then
    brew services start sketchybar >/dev/null 2>&1 || true
  fi
}

case "${1:-}" in
  aerospace)
    have aerospace || {
      echo 'AeroSpace is not installed: brew install --cask nikitabobko/tap/aerospace' >&2
      exit 1
    }
    stop_yabai
    open -a AeroSpace
    reload_bar
    echo 'window manager: AeroSpace'
    ;;
  yabai)
    have yabai || {
      echo 'yabai is not installed: brew install asmvik/formulae/yabai' >&2
      exit 1
    }
    have skhd || {
      echo 'skhd is not installed: brew install asmvik/formulae/skhd' >&2
      exit 1
    }
    stop_aerospace
    yabai --start-service
    skhd --start-service
    reload_bar
    echo 'window manager: yabai + skhd'
    ;;
  off)
    stop_aerospace
    stop_yabai
    reload_bar
    echo 'window manager: off'
    ;;
  status)
    if pgrep -x AeroSpace >/dev/null 2>&1; then
      echo 'AeroSpace: running'
    else
      echo 'AeroSpace: stopped'
    fi
    if have yabai && yabai -m query --spaces >/dev/null 2>&1; then
      echo 'yabai: running'
    else
      echo 'yabai: stopped'
    fi
    if pgrep -x sketchybar >/dev/null 2>&1; then
      echo 'SketchyBar: running'
    else
      echo 'SketchyBar: stopped'
    fi
    ;;
  *) usage ;;
esac
