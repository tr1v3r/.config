{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "153",
    "margin": 1
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "┃ ",
    "color": "146",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "111",
    "bold": true
  },
  "h1": {
    "prefix": "▎ ",
    "color": "117",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "111"
  },
  "h3": {
    "prefix": "### ",
    "color": "141"
  },
  "h4": {
    "prefix": "#### ",
    "color": "38"
  },
  "h5": {
    "prefix": "##### ",
    "color": "149"
  },
  "h6": {
    "prefix": "###### ",
    "color": "60",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "color": "60",
    "crossed_out": true
  },
  "emph": {
    "color": "146",
    "italic": true
  },
  "strong": {
    "color": "153",
    "bold": true
  },
  "hr": {
    "color": "239",
    "format": "\n────────────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "117",
    "underline": true
  },
  "link_text": {
    "color": "111",
    "bold": true
  },
  "image": {
    "color": "141",
    "underline": true
  },
  "image_text": {
    "color": "60",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "210",
    "background_color": "236"
  },
  "code_block": {
    "color": "153",
    "margin": 1,
    "chroma": {
      "text": {
        "color": "#c0caf5"
      },
      "error": {
        "color": "#1a1b26",
        "background_color": "#f7768e"
      },
      "comment": {
        "color": "#565f89"
      },
      "comment_preproc": {
        "color": "#e0af68"
      },
      "keyword": {
        "color": "#bb9af7"
      },
      "keyword_reserved": {
        "color": "#f7768e"
      },
      "keyword_namespace": {
        "color": "#7aa2f7"
      },
      "keyword_type": {
        "color": "#2ac3de"
      },
      "operator": {
        "color": "#89ddff"
      },
      "punctuation": {
        "color": "#a9b1d6"
      },
      "name": {
        "color": "#c0caf5"
      },
      "name_builtin": {
        "color": "#bb9af7"
      },
      "name_tag": {
        "color": "#f7768e"
      },
      "name_attribute": {
        "color": "#9ece6a"
      },
      "name_class": {
        "color": "#7aa2f7",
        "bold": true
      },
      "name_constant": {
        "color": "#ff9e64"
      },
      "name_decorator": {
        "color": "#e0af68"
      },
      "name_exception": {
        "color": "#f7768e"
      },
      "name_function": {
        "color": "#7aa2f7"
      },
      "literal": {
        "color": "#c0caf5"
      },
      "literal_number": {
        "color": "#ff9e64"
      },
      "literal_date": {
        "color": "#e0af68"
      },
      "literal_string": {
        "color": "#9ece6a"
      },
      "literal_string_escape": {
        "color": "#7dcfff"
      },
      "generic_deleted": {
        "color": "#f7768e"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#9ece6a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#565f89"
      },
      "background": {
        "background_color": "#1f2335"
      }
    }
  },
  "table": {
    "color": "146"
  },
  "definition_list": {},
  "definition_term": {
    "color": "117",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "  ↳ ",
    "color": "146"
  },
  "html_block": {
    "color": "60"
  },
  "html_span": {
    "color": "60"
  }
}
