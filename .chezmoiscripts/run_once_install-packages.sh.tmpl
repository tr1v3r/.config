#!/bin/bash
# Install system packages (delegates to the repo bootstrap script).
# NOTE: shebang MUST stay on line 1 — anything above it breaks exec.
# NOTE: use $CHEZMOI_SOURCE_DIR, NOT `chezmoi source-path` — a nested chezmoi
# call deadlocks on the persistent state lock while apply is running.
set -euo pipefail
SRC="${CHEZMOI_SOURCE_DIR:-}"
[ -n "$SRC" ] || SRC="$(chezmoi source-path)"
cd "$SRC"
if [[ "$(uname -s)" == "Darwin" ]]; then
	exec ./scripts/init_mac.sh
else
	exec ./scripts/init.sh
fi
