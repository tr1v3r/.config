# Per-machine runtime params. Copy to .qbittorrent.env (gitignored) and fill in:
#   cp .qbittorrent.env.example .qbittorrent.env
#   sed -i '' "s/^PUID=.*/PUID=$(id -u)/; s/^PGID=.*/PGID=$(id -g)/" .qbittorrent.env   # macOS
#   sed -i    "s/^PUID=.*/PUID=$(id -u)/; s/^PGID=.*/PGID=$(id -g)/" .qbittorrent.env   # Linux
# macOS first user is often 501; Linux servers are usually 1000.
PUID=1000
PGID=1000
TZ=Asia/Shanghai
WEBUIPORT=8088   # Web UI port — applied on first boot; must match the compose port mapping
